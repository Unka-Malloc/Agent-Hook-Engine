# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Build output and local process material — never source, never published.
*.log
*.tmp
tmp/
coverage/
.cache/

# Temporary reports and plans
docs/plans/
docs/reports/

# Secrets — commit .env.example only
.env
.env.*
!.env.example

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.swo

# Legacy reference scripts' interpreter state
__pycache__/
*.py[cod]
